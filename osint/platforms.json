[
  {
    "name": "GitHub",
    "url_pattern": "https://github.com/{username}",
    "error_type": "status_code",
    "reliability": "verified",
    "expected_status": [
      404,
      410
    ],
    "probe_url_pattern": "https://api.github.com/users/{username}",
    "check": "json",
    "json_path": "login",
    "metadata_fields": {
      "username": "login",
