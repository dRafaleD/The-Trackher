[
  {
    "name": "GitHub",
    "category": "heuristic",
    "section": "account",
    "check": "public_profile_email",
    "url": "https://github.com/",
    "probe_url": "https://api.github.com/search/users?q=%22{email}%22%20in:email",
    "items_path": "items",
    "profile_url_field": "url",
    "profile_email_field": "email",
    "label_field": "login",
    "profile_check_limit": 5,
    "profile_metadata_fields": {
      "username": "login",
      "display_name": "name",
      "website": "blog",
      "avatar_url": "avatar_url",
      "profile_url": "html_url"
    },
    "headers": {
      "User-Agent": "Trackher"
    },
    "actions": [
      {
        "type": "Account Security / 2FA",
        "label": "Account Security / 2FA",
        "url": "https://docs.github.com/en/authentication/securing-your-account-with-two-factor-authentication-2fa/about-two-factor-authentication"
      },
      {
        "type": "Data Export",
        "label": "Data Export",
        "url": "https://docs.github.com/en/get-started/archiving-your-github-personal-account-and-public-repositories/requesting-an-archive-of-your-personal-accounts-data"
      },
      {
        "type": "Delete Account / Help",
        "label": "Delete Account / Help",
        "url": "https://docs.github.com/en/account-and-profile/how-tos/account-management/deleting-your-personal-account"
      }
    ]
  },
  {
    "name": "GitLab",
    "category": "verified",
    "section": "account",
    "check": "public_profile_email",
    "url": "https://gitlab.com/",
    "probe_url": "https://gitlab.com/api/v4/users?search={email}",
    "items_path": "",
    "profile_url_template": "https://gitlab.com/api/v4/users/{id}",
    "profile_email_field": "public_email",
    "label_field": "username",
    "profile_check_limit": 5,
    "profile_metadata_fields": {
      "username": "username",
      "display_name": "name",
      "website": "website_url",
      "avatar_url": "avatar_url",
      "profile_url": "web_url"
    },
    "headers": {
      "User-Agent": "Trackher"
    },
    "actions": [
      {
        "type": "Account Security / 2FA",
        "label": "Account Security / 2FA",
        "url": "https://docs.gitlab.com/user/profile/account/two_factor_authentication/"
      },
      {
        "type": "Privacy Settings",
        "label": "Privacy Settings",
        "url": "https://docs.gitlab.com/user/profile/"
      },
      {
        "type": "Delete Account / Help",
        "label": "Delete Account / Help",
        "url": "https://docs.gitlab.com/user/profile/account/delete_account/"
      }
    ]
  },
